<block wx:if="{{project}}"><view class="project-detail-container data-v-0bde5540"><view class="header-card data-v-0bde5540"><view class="{{['project-type','data-v-0bde5540','type-'+project.type]}}">{{project.typeName}}</view><view class="project-title data-v-0bde5540">{{project.name}}</view><view class="project-meta data-v-0bde5540"><text class="data-v-0bde5540">{{"👤 "+project.managerName}}</text><text class="data-v-0bde5540">{{"📅 "+project.startTime+" ~ "+project.endTime}}</text></view><view class="progress-section data-v-0bde5540"><view class="progress-info data-v-0bde5540"><text class="data-v-0bde5540">项目进度</text><text class="progress-value data-v-0bde5540">{{project.progress+"%"}}</text></view><view class="progress-bar data-v-0bde5540"><view class="progress-inner data-v-0bde5540" style="{{'width:'+(project.progress+'%')+';'}}"></view></view></view></view><view class="section data-v-0bde5540"><view class="section-title data-v-0bde5540">项目描述</view><view class="section-content data-v-0bde5540">{{project.description||'暂无描述'}}</view></view><view class="section data-v-0bde5540"><view class="section-header data-v-0bde5540"><view class="section-title data-v-0bde5540">相关任务</view><text data-event-opts="{{[['tap',[['goToAddTask',['$event']]]]]}}" class="add-text data-v-0bde5540" bindtap="__e">+ 新建任务</text></view><view class="task-list data-v-0bde5540"><block wx:for="{{$root.l0}}" wx:for-item="task" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['goToTaskDetail',['$0'],[[['projectTasks','id',task.$orig.id,'id']]]]]]]}}" class="task-item data-v-0bde5540" bindtap="__e"><view class="task-title data-v-0bde5540">{{task.$orig.title}}</view><view class="task-info data-v-0bde5540"><text class="data-v-0bde5540">{{"负责人："+task.$orig.assigneeName}}</text><text class="deadline data-v-0bde5540">{{"截止："+task.$orig.deadline}}</text></view><view class="{{['task-status','data-v-0bde5540','status-'+task.$orig.status]}}">{{task.m0}}</view></view></block></view></view><view class="action-bar data-v-0bde5540"><button data-event-opts="{{[['tap',[['goToEdit',['$event']]]]]}}" class="action-btn edit-btn data-v-0bde5540" bindtap="__e">编辑项目</button><button data-event-opts="{{[['tap',[['updateStatus',['$event']]]]]}}" class="action-btn primary-btn data-v-0bde5540" bindtap="__e">更新状态</button></view></view></block>