<view class="edit-container data-v-2c9c3e2b"><view class="form-section data-v-2c9c3e2b"><view class="form-item data-v-2c9c3e2b"><view class="form-label data-v-2c9c3e2b">任务标题 <text class="required data-v-2c9c3e2b">*</text></view><input class="form-input data-v-2c9c3e2b" placeholder="请输入任务标题" data-event-opts="{{[['input',[['__set_model',['$0','title','$event',[]],['form']]]]]}}" value="{{form.title}}" bindinput="__e"/></view><view class="form-item data-v-2c9c3e2b"><view class="form-label data-v-2c9c3e2b">所属项目 <text class="required data-v-2c9c3e2b">*</text></view><picker mode="selector" range="{{projectList}}" range-key="name" data-event-opts="{{[['change',[['onProjectChange',['$event']]]]]}}" bindchange="__e" class="data-v-2c9c3e2b"><view class="picker-value data-v-2c9c3e2b">{{$root.m0}}</view></picker></view><view class="form-item data-v-2c9c3e2b"><view class="form-label data-v-2c9c3e2b">负责人 <text class="required data-v-2c9c3e2b">*</text></view><picker mode="selector" range="{{userList}}" range-key="name" data-event-opts="{{[['change',[['onAssigneeChange',['$event']]]]]}}" bindchange="__e" class="data-v-2c9c3e2b"><view class="picker-value data-v-2c9c3e2b">{{form.assigneeName||'请选择负责人'}}</view></picker></view><view class="form-item data-v-2c9c3e2b"><view class="form-label data-v-2c9c3e2b">截止时间 <text class="required data-v-2c9c3e2b">*</text></view><picker mode="date" data-event-opts="{{[['change',[['onDeadlineChange',['$event']]]]]}}" bindchange="__e" class="data-v-2c9c3e2b"><view class="picker-value data-v-2c9c3e2b">{{form.deadline||'请选择截止时间'}}</view></picker></view><view class="form-item data-v-2c9c3e2b"><view class="form-label data-v-2c9c3e2b">优先级 <text class="required data-v-2c9c3e2b">*</text></view><view class="priority-select data-v-2c9c3e2b"><block wx:for="{{priorityList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="value"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['priority-item','data-v-2c9c3e2b',(form.priority===item.value)?'active':'']}}" bindtap="__e">{{''+item.label+''}}</view></block></view></view><view class="form-item data-v-2c9c3e2b"><view class="form-label data-v-2c9c3e2b">任务描述</view><textarea class="form-textarea data-v-2c9c3e2b" placeholder="请输入任务描述" data-event-opts="{{[['input',[['__set_model',['$0','content','$event',[]],['form']]]]]}}" value="{{form.content}}" bindinput="__e"></textarea></view></view><view class="submit-section data-v-2c9c3e2b"><button class="submit-btn data-v-2c9c3e2b" loading="{{loading}}" data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" bindtap="__e">保存</button></view></view>