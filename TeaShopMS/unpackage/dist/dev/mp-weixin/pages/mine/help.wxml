<view class="help-container data-v-9857f658"><view class="header data-v-9857f658"><view class="header-left data-v-9857f658"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="back-icon data-v-9857f658" bindtap="__e">‹</text><text class="header-title data-v-9857f658">帮助与反馈</text></view></view><view class="section data-v-9857f658"><view class="section-title data-v-9857f658">常见问题</view><view class="faq-list data-v-9857f658"><block wx:for="{{faqList}}" wx:for-item="faq" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleFaq',[index]]]]]}}" class="faq-item data-v-9857f658" bindtap="__e"><view class="faq-header data-v-9857f658"><text class="faq-question data-v-9857f658">{{faq.question}}</text><text class="{{['faq-arrow','data-v-9857f658',(expandedFaq===index)?'expanded':'']}}">▼</text></view><block wx:if="{{expandedFaq===index}}"><view class="faq-answer data-v-9857f658">{{''+faq.answer+''}}</view></block></view></block></view></view><view class="section data-v-9857f658"><view class="section-title data-v-9857f658">反馈问题</view><view class="feedback-form data-v-9857f658"><view class="form-item data-v-9857f658"><text class="form-label data-v-9857f658">问题类型</text><picker class="form-picker data-v-9857f658" value="{{feedbackTypeIndex}}" range="{{feedbackTypes}}" data-event-opts="{{[['change',[['onFeedbackTypeChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-9857f658">{{feedbackTypes[feedbackTypeIndex]}}</view></picker></view><view class="form-item data-v-9857f658"><text class="form-label data-v-9857f658">问题描述</text><textarea class="form-textarea data-v-9857f658" placeholder="请详细描述您遇到的问题" data-event-opts="{{[['input',[['__set_model',['','feedbackContent','$event',[]]]]]]}}" value="{{feedbackContent}}" bindinput="__e"></textarea></view><view class="form-item data-v-9857f658"><text class="form-label data-v-9857f658">联系方式</text><input class="form-input data-v-9857f658" placeholder="请留下您的手机号或邮箱" data-event-opts="{{[['input',[['__set_model',['','contactInfo','$event',[]]]]]]}}" value="{{contactInfo}}" bindinput="__e"/></view><view class="form-item data-v-9857f658"><text class="form-label data-v-9857f658">上传截图</text><view class="upload-container data-v-9857f658"><block wx:for="{{uploadedImages}}" wx:for-item="image" wx:for-index="index" wx:key="index"><view class="upload-item data-v-9857f658"><image class="upload-image data-v-9857f658" src="{{image}}"></image><text data-event-opts="{{[['tap',[['removeImage',[index]]]]]}}" class="upload-remove data-v-9857f658" bindtap="__e">×</text></view></block><block wx:if="{{$root.g0<3}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="upload-add data-v-9857f658" bindtap="__e"><text class="upload-icon data-v-9857f658">+</text><text class="upload-text data-v-9857f658">添加图片</text></view></block></view></view><button data-event-opts="{{[['tap',[['submitFeedback',['$event']]]]]}}" class="submit-btn data-v-9857f658" bindtap="__e">提交反馈</button></view></view><view class="section data-v-9857f658"><view class="section-title data-v-9857f658">联系我们</view><view class="contact-info data-v-9857f658"><view class="contact-item data-v-9857f658"><text class="contact-icon data-v-9857f658">📧</text><text class="contact-text data-v-9857f658">support@teashop.com</text></view><view class="contact-item data-v-9857f658"><text class="contact-icon data-v-9857f658">📞</text><text class="contact-text data-v-9857f658">400-123-4567</text></view><view class="contact-item data-v-9857f658"><text class="contact-icon data-v-9857f658">🕐</text><text class="contact-text data-v-9857f658">工作时间：9:00-18:00</text></view></view></view></view>