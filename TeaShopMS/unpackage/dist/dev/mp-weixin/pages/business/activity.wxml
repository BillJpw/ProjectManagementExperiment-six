<view class="activity-container data-v-5046fb56"><view class="header data-v-5046fb56"><view class="header-title data-v-5046fb56">🎉 活动策划</view><view class="header-desc data-v-5046fb56">节日促销、新品上线活动管理</view></view><view class="activity-list data-v-5046fb56"><block wx:for="{{activities}}" wx:for-item="activity" wx:for-index="__i0__" wx:key="id"><view class="activity-card data-v-5046fb56"><view class="activity-banner data-v-5046fb56" style="{{'background:'+(activity.bannerBg)+';'}}"><text class="activity-type data-v-5046fb56">{{activity.typeName}}</text></view><view class="activity-content data-v-5046fb56"><view class="activity-title data-v-5046fb56">{{activity.name}}</view><view class="activity-date data-v-5046fb56">{{"📅 "+activity.startDate+" ~ "+activity.endDate}}</view><view class="activity-desc data-v-5046fb56">{{activity.description}}</view><view class="activity-meta data-v-5046fb56"><text class="meta-item data-v-5046fb56">{{"👤 "+activity.manager}}</text><text class="meta-item data-v-5046fb56">{{"📊 "+activity.statusName}}</text></view><view class="activity-actions data-v-5046fb56"><button class="action-btn data-v-5046fb56" size="mini" data-event-opts="{{[['tap',[['viewDetail',['$0'],[[['activities','id',activity.id]]]]]]]}}" bindtap="__e">查看详情</button><block wx:if="{{activity.status==='planning'}}"><button class="action-btn primary data-v-5046fb56" size="mini" data-event-opts="{{[['tap',[['startActivity',['$0'],[[['activities','id',activity.id]]]]]]]}}" bindtap="__e">启动活动</button></block></view></view></view></block></view><view data-event-opts="{{[['tap',[['showAddDialog',['$event']]]]]}}" class="add-btn data-v-5046fb56" bindtap="__e"><text class="add-icon data-v-5046fb56">+</text></view><block wx:if="{{showAdd}}"><view class="dialog data-v-5046fb56"><view class="dialog-content data-v-5046fb56"><view class="dialog-header data-v-5046fb56"><text class="dialog-title data-v-5046fb56">新建活动</text><text data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="dialog-close data-v-5046fb56" bindtap="__e">×</text></view><view class="dialog-body data-v-5046fb56"><view class="form-item data-v-5046fb56"><text class="form-label data-v-5046fb56">活动名称</text><input class="form-input data-v-5046fb56" placeholder="请输入活动名称" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['newActivity']]]]]}}" value="{{newActivity.name}}" bindinput="__e"/></view><view class="form-item data-v-5046fb56"><text class="form-label data-v-5046fb56">活动类型</text><picker class="form-picker data-v-5046fb56" value="{{activityTypeIndex}}" range="{{activityTypes}}" data-event-opts="{{[['change',[['onTypeChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-5046fb56">{{activityTypes[activityTypeIndex]}}</view></picker></view><view class="form-item data-v-5046fb56"><text class="form-label data-v-5046fb56">开始日期</text><picker class="form-picker data-v-5046fb56" mode="date" value="{{newActivity.startDate}}" data-event-opts="{{[['change',[['onStartDateChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-5046fb56">{{newActivity.startDate}}</view></picker></view><view class="form-item data-v-5046fb56"><text class="form-label data-v-5046fb56">结束日期</text><picker class="form-picker data-v-5046fb56" mode="date" value="{{newActivity.endDate}}" data-event-opts="{{[['change',[['onEndDateChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-5046fb56">{{newActivity.endDate}}</view></picker></view><view class="form-item data-v-5046fb56"><text class="form-label data-v-5046fb56">活动描述</text><textarea class="form-textarea data-v-5046fb56" placeholder="请输入活动描述" data-event-opts="{{[['input',[['__set_model',['$0','description','$event',[]],['newActivity']]]]]}}" value="{{newActivity.description}}" bindinput="__e"></textarea></view></view><view class="dialog-footer data-v-5046fb56"><button data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="btn-cancel data-v-5046fb56" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['addActivity',['$event']]]]]}}" class="btn-confirm data-v-5046fb56" bindtap="__e">确定</button></view></view></view></block><block wx:if="{{showDetailDialog}}"><view class="dialog data-v-5046fb56"><view class="dialog-content data-v-5046fb56"><view class="dialog-header data-v-5046fb56"><text class="dialog-title data-v-5046fb56">活动详情</text><text data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="dialog-close data-v-5046fb56" bindtap="__e">×</text></view><view class="dialog-body data-v-5046fb56"><view class="detail-item data-v-5046fb56"><text class="detail-label data-v-5046fb56">活动名称</text><text class="detail-value data-v-5046fb56">{{selectedActivity.name}}</text></view><view class="detail-item data-v-5046fb56"><text class="detail-label data-v-5046fb56">活动类型</text><text class="detail-value data-v-5046fb56">{{selectedActivity.typeName}}</text></view><view class="detail-item data-v-5046fb56"><text class="detail-label data-v-5046fb56">活动时间</text><text class="detail-value data-v-5046fb56">{{selectedActivity.startDate+" ~ "+selectedActivity.endDate}}</text></view><view class="detail-item data-v-5046fb56"><text class="detail-label data-v-5046fb56">活动描述</text><text class="detail-value data-v-5046fb56">{{selectedActivity.description}}</text></view><view class="detail-item data-v-5046fb56"><text class="detail-label data-v-5046fb56">负责人</text><text class="detail-value data-v-5046fb56">{{selectedActivity.manager}}</text></view><view class="detail-item data-v-5046fb56"><text class="detail-label data-v-5046fb56">活动状态</text><text class="{{['detail-value','data-v-5046fb56','status-'+selectedActivity.status]}}">{{selectedActivity.statusName}}</text></view></view><view class="dialog-footer data-v-5046fb56"><button data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="btn-confirm data-v-5046fb56" bindtap="__e">关闭</button></view></view></view></block></view>