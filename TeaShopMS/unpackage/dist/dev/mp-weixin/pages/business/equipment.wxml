<view class="equipment-container data-v-4886aa90"><view class="header data-v-4886aa90"><view class="header-title data-v-4886aa90">⚙️ 设备维护</view><view class="header-desc data-v-4886aa90">制冰机、封口机、冰柜等设备管理</view></view><view class="stats-bar data-v-4886aa90"><view class="stat-item data-v-4886aa90"><view class="stat-value data-v-4886aa90">{{stats.total}}</view><view class="stat-label data-v-4886aa90">设备总数</view></view><view class="stat-item data-v-4886aa90"><view class="stat-value text-success data-v-4886aa90">{{stats.normal}}</view><view class="stat-label data-v-4886aa90">正常运行</view></view><view class="stat-item data-v-4886aa90"><view class="stat-value text-warning data-v-4886aa90">{{stats.maintaining}}</view><view class="stat-label data-v-4886aa90">维护中</view></view></view><view class="equipment-list data-v-4886aa90"><block wx:for="{{$root.l0}}" wx:for-item="equip" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['viewDetail',['$0'],[[['equipments','id',equip.$orig.id]]]]]]]}}" class="equipment-card data-v-4886aa90" bindtap="__e"><view class="{{['equipment-icon','data-v-4886aa90','icon-'+equip.$orig.status]}}">{{''+equip.$orig.icon+''}}</view><view class="equipment-info data-v-4886aa90"><view class="equipment-name data-v-4886aa90">{{equip.$orig.name}}</view><view class="equipment-location data-v-4886aa90">{{"📍 "+equip.$orig.location}}</view><view class="equipment-date data-v-4886aa90">{{"购买日期："+equip.$orig.purchaseDate}}</view><view class="{{['next-maintenance','data-v-4886aa90',(equip.m0)?'warning':'']}}">{{'下次维护：'+equip.$orig.nextMaintenance+''}}</view></view><view class="{{['equipment-status','data-v-4886aa90','status-'+equip.$orig.status]}}">{{''+equip.m1+''}}</view></view></block></view><view data-event-opts="{{[['tap',[['showAddDialog',['$event']]]]]}}" class="add-btn data-v-4886aa90" bindtap="__e"><text class="add-icon data-v-4886aa90">+</text></view><block wx:if="{{showDialog}}"><view class="dialog data-v-4886aa90"><view class="dialog-content data-v-4886aa90"><view class="dialog-header data-v-4886aa90"><text class="dialog-title data-v-4886aa90">{{isEditing?'编辑设备':'添加设备'}}</text><text data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="dialog-close data-v-4886aa90" bindtap="__e">×</text></view><view class="dialog-body data-v-4886aa90"><view class="form-item data-v-4886aa90"><text class="form-label data-v-4886aa90">设备名称</text><input class="form-input data-v-4886aa90" placeholder="请输入设备名称" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" value="{{form.name}}" bindinput="__e"/></view><view class="form-item data-v-4886aa90"><text class="form-label data-v-4886aa90">设备位置</text><input class="form-input data-v-4886aa90" placeholder="请输入设备位置" data-event-opts="{{[['input',[['__set_model',['$0','location','$event',[]],['form']]]]]}}" value="{{form.location}}" bindinput="__e"/></view><view class="form-item data-v-4886aa90"><text class="form-label data-v-4886aa90">购买日期</text><picker class="form-picker data-v-4886aa90" mode="date" value="{{form.purchaseDate}}" data-event-opts="{{[['change',[['onPurchaseDateChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-4886aa90">{{form.purchaseDate}}</view></picker></view><view class="form-item data-v-4886aa90"><text class="form-label data-v-4886aa90">下次维护日期</text><picker class="form-picker data-v-4886aa90" mode="date" value="{{form.nextMaintenance}}" data-event-opts="{{[['change',[['onNextMaintenanceChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-4886aa90">{{form.nextMaintenance}}</view></picker></view><block wx:if="{{isEditing}}"><view class="form-item data-v-4886aa90"><text class="form-label data-v-4886aa90">设备状态</text><picker class="form-picker data-v-4886aa90" value="{{statusIndex}}" range="{{statusList}}" data-event-opts="{{[['change',[['onStatusChange',['$event']]]]]}}" bindchange="__e"><view class="picker-text data-v-4886aa90">{{statusList[statusIndex]}}</view></picker></view></block></view><view class="dialog-footer data-v-4886aa90"><button data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="btn-cancel data-v-4886aa90" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['saveEquipment',['$event']]]]]}}" class="btn-confirm data-v-4886aa90" bindtap="__e">确定</button></view></view></view></block><block wx:if="{{showDetailDialog}}"><view class="dialog data-v-4886aa90"><view class="dialog-content data-v-4886aa90"><view class="dialog-header data-v-4886aa90"><text class="dialog-title data-v-4886aa90">设备详情</text><text data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="dialog-close data-v-4886aa90" bindtap="__e">×</text></view><view class="dialog-body data-v-4886aa90"><view class="detail-item data-v-4886aa90"><text class="detail-label data-v-4886aa90">设备名称</text><text class="detail-value data-v-4886aa90">{{selectedEquipment.name}}</text></view><view class="detail-item data-v-4886aa90"><text class="detail-label data-v-4886aa90">设备位置</text><text class="detail-value data-v-4886aa90">{{selectedEquipment.location}}</text></view><view class="detail-item data-v-4886aa90"><text class="detail-label data-v-4886aa90">购买日期</text><text class="detail-value data-v-4886aa90">{{selectedEquipment.purchaseDate}}</text></view><view class="detail-item data-v-4886aa90"><text class="detail-label data-v-4886aa90">下次维护</text><text class="{{['detail-value','data-v-4886aa90',($root.m2)?'warning':'']}}">{{''+selectedEquipment.nextMaintenance+''}}</text></view><view class="detail-item data-v-4886aa90"><text class="detail-label data-v-4886aa90">设备状态</text><text class="{{['detail-value','data-v-4886aa90','status-'+selectedEquipment.status]}}">{{''+$root.m3+''}}</text></view></view><view class="dialog-footer data-v-4886aa90"><button data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="btn-cancel data-v-4886aa90" bindtap="__e">关闭</button><button data-event-opts="{{[['tap',[['editEquipment',['$0'],['selectedEquipment']]]]]}}" class="btn-confirm data-v-4886aa90" bindtap="__e">编辑</button><button data-event-opts="{{[['tap',[['toggleMaintenance',['$0'],['selectedEquipment']]]]]}}" class="btn-primary data-v-4886aa90" bindtap="__e">{{''+(selectedEquipment.status==='maintaining'?'结束维护':'开始维护')+''}}</button></view></view></view></block></view>